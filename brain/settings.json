{
  "env": {
    "DISABLE_TELEMETRY": "1",
    "DISABLE_ERROR_REPORTING": "1",
    "DISABLE_FEEDBACK_COMMAND": "1",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "permissions": {
    "allow": [
      "mcp__plugin_justday_kwin__look",
      "mcp__plugin_justday_kwin__list_windows",
      "mcp__plugin_justday_kwin__focus_window",
      "mcp__plugin_justday_kwin__accessibility_tree",
      "mcp__plugin_justday_kwin__find_ui_elements",
      "mcp__plugin_justday_kwin__wait_for_element",
      "mcp__plugin_justday_kwin__mouse_move",
      "mcp__plugin_justday_kwin__mouse_scroll",
      "Bash(justday apps:*)",
      "Bash(justday windows:*)",
      "Bash(justday games:*)",
      "Bash(justday recent:*)",
      "Bash(justday screenshot:*)",
      "Bash(justday claude list:*)",
      "Bash(justday claude result:*)",
      "Bash(justday contacts:*)",
      "Bash(justday compose-mail:*)",
      "Bash(gtk-launch:*)",
      "Bash(xdg-open:*)",
      "Bash(playerctl:*)",
      "Bash(wpctl get-volume:*)",
      "Bash(wpctl set-volume:*)",
      "Bash(wpctl set-mute:*)",
      "Bash(pgrep:*)",
      "Bash(plocate:*)",
      "Bash(notify-send:*)"
    ],
    "ask": [
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(rm -fr:*)",
      "Bash(sudo:*)",
      "Bash(pkexec:*)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Bash(shred:*)",
      "Bash(wipefs:*)",
      "Bash(parted:*)",
      "Bash(fdisk:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git branch -D:*)",
      "Bash(dnf remove:*)",
      "Bash(dnf erase:*)",
      "Bash(rpm -e:*)",
      "Bash(flatpak uninstall:*)",
      "Bash(firewall-cmd:*)",
      "Bash(grubby:*)",
      "Bash(bootctl:*)",
      "Bash(efibootmgr:*)",
      "Bash(systemctl disable:*)",
      "Bash(systemctl mask:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh release create:*)",
      "Bash(npm publish:*)",
      "Bash(cargo publish:*)"
    ],
    "deny": [
      "Bash(justday mail:*)",
      "Bash(justday secret:*)",
      "Bash(jarvis mail:*)",
      "Bash(jarvis secret:*)",
      "Bash(secret-tool:*)",
      "Read(~/.local/share/justday/ollama/**)",
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(**/*.key)",
      "Read(~/.local/share/keyrings/**)"
    ]
  }
}
