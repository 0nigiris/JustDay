         двигает фон и передний план относительно друг друга, и на плоском
         чёрном это выглядело бы дырой. -->
    <path android:pathData="M0,0 h108 v108 h-108 z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="linear"
                android:startX="0" android:startY="0"
                android:endX="0" android:endY="108">
                <item android:offset="0" android:color="#1B2440"/>
                <item android:offset="0.55" android:color="#0B0E1A"/>
                <item android:offset="1" android:color="#05060B"/>
            </gradient>
        </aapt:attr>
    </path>
    <path android:pathData="M54,60 m-40,0 a40,40 0 1,0 80,0 a40,40 0 1,0 -80,0">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial"
                android:centerX="54" android:centerY="60" android:gradientRadius="40">
                <item android:offset="0" android:color="#66FF9A4D"/>
                <item android:offset="1" android:color="#00FF9A4D"/>
            </gradient>
        </aapt:attr>
    </path>
</vector>
