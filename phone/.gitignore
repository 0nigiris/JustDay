firmware/managed_components/
firmware/dependencies.lock
firmware/main/wifi_secrets.h

# Прочее
.DS_Store
*.log

# Рабочая заметка о конкретной машине: публичный IP, модель роутера,
# имя тайлнета, чужой адрес почты. В репозиторий не идёт.
docs/SESSION-STATE.md

# Сборка Android: промежуточные файлы, готовый APK и ключ подписи.
# Ключ — секрет: с ним можно подписать что угодно от имени этого приложения.
android/build/
android/dist/
android/*.keystore
# Адрес тайлнета этого дома.
android/url.txt

