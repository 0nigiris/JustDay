# Секреты и локальная конфигурация — НИКОГДА не коммитить
.env
.env.*
!.env.example
# Рабочие конфигурации могут содержать частные адреса — коммитим только примеры
config/*.toml
!config/*.example.toml
config.toml
config.local.toml
*.secret
*.key
!*.key.example
secrets/
data/
*.db
*.sqlite3

# ESP-IDF
firmware/build/
firmware/sdkconfig
