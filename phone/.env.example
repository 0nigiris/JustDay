# Пример переменных окружения Remo32.
#
# Скопируйте в .env (он в .gitignore) либо, что правильнее для служб, —
# в ~/.config/remo32/agent.env и ~/.config/remo32/controller.env
# с правами 0600.
#
# НИ ОДНО ИЗ ЭТИХ ЗНАЧЕНИЙ НЕ ДОЛЖНО ПОПАСТЬ В GIT.

# ---------------------------------------------------------------------------
# АГЕНТ (на каждом управляемом ПК)
# ---------------------------------------------------------------------------

# Общий секрет между агентом и контроллером. Минимум 24 символа.
# Сгенерировать: uv run remo32-agent --generate-token
REMO32_AGENT_TOKEN=

# Путь к файлу конфигурации (если не в стандартном месте)
# REMO32_AGENT_CONFIG=/home/пользователь/.config/remo32/agent.toml

# Переопределение отдельных настроек (двойное подчёркивание = вложенность)
# REMO32_AGENT_SERVER__HOST=100.64.0.10
# REMO32_AGENT_SERVER__PORT=8765
# REMO32_AGENT_POWER__DRY_RUN=true        # только логировать выключение
# REMO32_AGENT_TERMINAL__ENABLED=true     # включить удалённый терминал

# ---------------------------------------------------------------------------
# КОНТРОЛЛЕР
# ---------------------------------------------------------------------------

# Хэш пароля для входа в веб-интерфейс.
# Сгенерировать: uv run remo32-controller --hash-password
REMO32_PASSWORD_HASH=

# Ключ подписи сессий. Если не задан — создастся файл session.key в data_dir.
# Сгенерировать: uv run remo32-controller --gen-secret
# REMO32_SESSION_SECRET=

# Токены агентов. Либо один общий:
# REMO32_AGENT_TOKEN=...
# либо по одному на каждый ПК (имя переменной задаётся в controller.toml):
# REMO32_AGENT_TOKEN_DESKTOP=
# REMO32_AGENT_TOKEN_SERVER=

# Токен ESP32 при transport = "http"
# REMO32_ESP32_TOKEN=

# Пароль MQTT-брокера при transport = "mqtt"
# REMO32_MQTT_PASSWORD=

# Переопределение настроек контроллера
# REMO32_SERVER__HOST=100.64.0.10
# REMO32_SERVER__PORT=8080
# REMO32_SERVER__PUBLIC_ORIGIN=https://desktop.tailnet-abc123.ts.net:8080
# REMO32_AUTH__WEBAUTHN_RP_ID=desktop.tailnet-abc123.ts.net
