[Unit]
Description=JustDay on-screen indicator (layer-shell overlay)
PartOf=graphical-session.target
After=graphical-session.target justday.service

[Service]
Type=simple
ExecStart=/usr/bin/python3 @REPO@/src/justday/overlay.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
