[Unit]
Description=JustDay neural voice (Qwen3-TTS)
PartOf=graphical-session.target
After=graphical-session.target
Requires=justday-voice.socket
After=justday-voice.socket

[Service]
Type=simple
ExecStart=%h/.local/share/justday/voice/.venv/bin/python @REPO@/voice/server.py
Environment=PYTHONUNBUFFERED=1
Restart=on-failure
# Выход по простою — не отказ: гнездо поднимет службу на следующую просьбу.
SuccessExitStatus=0
RestartSec=5
# Без [Install]: служба не стартует при входе, её поднимает гнездо по первой просьбе. С ним
# она занимала полгигабайта с самого входа, даже когда голос выключен (Р3-22).
