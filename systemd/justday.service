[Unit]
Description=JustDay voice desktop agent
PartOf=graphical-session.target
After=graphical-session.target pipewire.service

[Service]
Type=simple
ExecStart=@JUSTDAY@ daemon
Environment=PATH=@PATH@
Environment=PYTHONUNBUFFERED=1
# Сколько куч glibc заводит под потоки. По умолчанию их до восьми на ядро, каждая по 64 МБ, и у
# демона с шестью десятками потоков (распознавание речи, звук, инференс) они съедали больше гигабайта
# — не данными, а пустотой между ними. Двух хватает: демон почти всё время ждёт, а не считает.
Environment=MALLOC_ARENA_MAX=2
Restart=on-failure
# Упал — сохранить журнал и версии (justday crashlog), а не перезапускаться молча.
ExecStopPost=-@JUSTDAY@ crashlog justday.service
RestartSec=5
TimeoutStopSec=15
# Programs and games the assistant starts must outlive a daemon restart: only the daemon itself is stopped
# (it shuts its own helpers down), everything it launched keeps running.
KillMode=process
# The daemon only listens on a user-only Unix socket; no network ports.

[Install]
WantedBy=graphical-session.target
