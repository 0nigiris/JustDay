{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/scripts/snapshot.sh\" save --quiet",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
